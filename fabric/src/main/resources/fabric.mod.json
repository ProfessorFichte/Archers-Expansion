{
	"schemaVersion": 1,
	"id": "archers_expansion",
	"version": "${version}",
	"name": "Archers Expansion",
	"description": "Extends the Archers-Mod (RPG Series) with new content. Spell Engine Add-On",
	"authors": [
		"Fichte"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/archers-expansion",
		"sources": "https://github.com/ProfessorFichte/Archers-Expansion",
		"issues": "https://github.com/ProfessorFichte/Archers-Expansion/issues"
	},
	"license": "ARR",
	"icon": "assets/archers_expansion/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.archers_expansion.fabric.FabricMod"
		],
		"client": [
			"com.archers_expansion.fabric.client.FabricClient"
		],
		"fabric-datagen": [
			"com.archers_expansion.ArchersExpansionDataGenerator"
		]
	},
	"mixins": [
		"archers-expansion.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_compat_version}",
		"minecraft": ">=${minecraft_compat_version}",
		"java": ">=21",
		"fabric-api": "*",
		"armor_model_api": ">=${armor_model_api_version}",
		"spell_engine": ">=${spell_engine_version}",
		"ranged_weapon_api": ">=${ranged_weapon_api_version}",
		"mrpg_lib": ">=${more_rpg_library_version}"
	},
	"suggests": {
		"bettercombat": "*",
		"armory_rpgs": "*",
		"mrpgc_skill_tree": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/AShKd5XrTu",
				"modmenu.kofi": "https://ko-fi.com/fichteee",
				"modmenu.modrinth": "https://modrinth.com/mod/archers-expansion",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/archers-expansion"
			}
		}
	}
}